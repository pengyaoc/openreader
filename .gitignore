# Data: DB, media cache — never committed
/data/

# Your personal feed list, filter rules, and interest profile — never
# committed. See config/feeds.example.yaml for the template this repo ships.
/config/feeds.yaml

# Leftover from the removed Gmail OAuth connector (2026-08-13, see
# docs/WORKLOG.md) — no longer read by any code path, but still a real
# credential file if present on disk, so it stays ignored rather than
# risking it getting committed by a future broad `git add`.
/config/gmail_client_secret.json

# IMAP credentials (READER_IMAP_HOST/_USER/_PASSWORD) if ever kept in a
# local env file for testing — the real one lives only on the VM at
# /opt/openreader/openreader.env, never in this repo. See docs/WORKLOG.md,
# 2026-08-12.
.env
*.env

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
/backend/.venv/

# Frontend
/frontend/node_modules/
/frontend/dist/

# Editor/OS
.DS_Store
